OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://your-provider.example.com/v1
OPENAI_MODEL=your-model-name

# Public chat model options are defined in app/services/agent/model_registry.py.
ENABLED_MODELS=ds-flash-fast,ds-flash-think,ds-pro-deep
DEFAULT_MODEL_ID=ds-flash-fast

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_KEY=
EMBEDDING_KEY=replace_with_your_embedding_api_key
EMBEDDING_BASE_URL=https://your-embedding-provider.example.com/v1
EMBEDDING_MODEL=your-embedding-model-name
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-replace_with_your_tavily_key
# Optional provider-independent override; takes priority over TAVILY_API_KEY.
# WEB_SEARCH_API_KEY=replace_with_your_search_api_key
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=7

# Optional rerank endpoint. For DashScope qwen3-vl-rerank, the client auto-selects the native endpoint.
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_MODEL=qwen3-vl-rerank
RERANK_TIMEOUT_SECONDS=5

# MCP integration is opt-in until evaluation gates pass.
MCP_SERVER_ENABLED=false
MCP_HTTP_ENABLED=false
MCP_HTTP_PATH=/mcp
MCP_AUTH_TOKEN=
MCP_CLIENT_ENABLED=false
MCP_CLIENT_TIMEOUT_SECONDS=10
MCP_CLIENT_RETRY_SECONDS=30
MCP_CLIENT_SERVERS=[]

# Temporary conversation PDF attachments. Relative roots resolve from the project root.
TEMP_DOCUMENT_ROOT=runtime_data/attachments
TEMP_DOCUMENT_MAX_BYTES=20971520
TEMP_DOCUMENT_TTL_HOURS=24
TEMP_DOCUMENT_MAX_FILES_PER_SESSION=5
TEMP_DOCUMENT_WRITE_CHUNK_BYTES=65536
TEMP_DOCUMENT_MAX_PAGES=300
TEMP_DOCUMENT_MIN_EXTRACTED_CHARS=20
TEMP_DOCUMENT_MAX_EXTRACTED_CHARS=2000000
TEMP_DOCUMENT_MAX_BLOCKS_PER_PAGE=5000
TEMP_DOCUMENT_CHUNK_CHARS=2000
TEMP_DOCUMENT_CHUNK_OVERLAP_CHARS=300
TEMP_DOCUMENT_RETRIEVAL_TOP_K=6
TEMP_DOCUMENT_CONTEXT_MAX_CHARS=8000
# Calibrated by the frozen cosine retrieval evaluation; revisit with model changes.
TEMP_DOCUMENT_SIMILARITY_THRESHOLD=0.45
# Local single-instance startup recovery only; not a durable worker queue.
TEMP_DOCUMENT_RECOVERY_BATCH_SIZE=50

# --- Storage & Server configuration ---
# Root directory for SQLite database and Chroma persistent storage.
# Defaults to the project root when not set.
# DATA_DIR=.

# Comma-separated CORS allowed origins. Defaults cover local Vite dev servers.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# FastAPI root_path for reverse-proxy prefix (e.g. /api behind nginx).
# ROOT_PATH=

# --- Agent observability MySQL ---
# MySQL stores only Agent traces and child events. SQLite remains the business
# database and Chroma remains the vector database. Tracing is disabled by
# default; MySQL failures never fail a chat request, but queued events may be
# dropped. Replace every password before using this file in production.
TRACE_DB_ENABLED=false
# Host-process defaults. docker-compose overrides these to mysql:3306 for api
# and trace-db-init containers.
TRACE_DB_HOST=127.0.0.1
TRACE_DB_PORT=3307
TRACE_DB_PUBLISHED_PORT=3307
TRACE_DB_USER=trace_user
TRACE_DB_PASSWORD=replace_with_a_strong_trace_password
TRACE_DB_NAME=tutor_agent_trace
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
TRACE_DB_CONNECT_TIMEOUT_SECONDS=3
TRACE_DB_QUEUE_SIZE=1000
TRACE_DB_SHUTDOWN_FLUSH_SECONDS=2
# Keep false unless the deployment explicitly accepts storing bounded prompts
# and retrieval queries. Tool previews are always bounded and secret-redacted.
TRACE_DB_CAPTURE_CONTENT=false
